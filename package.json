{
  "name": "context-connect",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/connectors/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "lint:root": "eslint eslint.config.mjs vitest.config.ts scripts",
    "test:root": "vitest run scripts",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "deploy": "bun run db:migrate:remote && turbo run deploy --filter='./apps/*'",
    "db:migrate:local": "bunx --bun wrangler d1 migrations apply DB --local --config apps/api-worker/wrangler.jsonc",
    "db:migrate:remote": "bunx --bun wrangler d1 migrations apply DB --remote --config apps/api-worker/wrangler.jsonc",
    "provision": "bun scripts/bootstrap/provision.ts",
    "reindex": "bun scripts/reindex/reindex.ts",
    "validate:requirements": "bun scripts/validate-requirements.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "latest",
    "eslint": "latest",
    "globals": "latest",
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "^5.9.2",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
